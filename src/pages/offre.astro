---
/**
 * Landing page des publicités Meta (Facebook / Instagram) : /offre
 * Un objectif : que le prospect remplisse le formulaire court (la demande part sur WhatsApp Business).
 * - Le formulaire est visible dès le premier écran, et répété en bas de page. Pas de menu, pas de lien sortant.
 * - Hors Google : noindex + absente du sitemap (astro.config.ts).
 * - Pixel Meta : variable PUBLIC_META_PIXEL_ID ; sans identifiant, aucun script. Événement « Lead » à l'envoi du formulaire.
 * - Animations : entrée du hero, surlignage, bandeau défilant, compteurs, cube 3D, apparitions au défilement.
 *   Tout est limité à transform / opacité et s'arrête avec prefers-reduced-motion.
 * - Le reste du site n'est pas modifié. Les programmes « Entrepreneuriat et innovation » ne sont pas proposés ici.
 */
import { getCollection } from 'astro:content';
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/Layout.astro';
import Logo from '~/components/Logo.astro';
import Photo from '~/components/nova/Photo.astro';
import Faq from '~/components/nova/Faq.astro';
import LeadForm from '~/components/nova/LeadForm.astro';
import LandingCube from '~/components/nova/LandingCube.astro';
import { SITE_CONFIG, CATEGORIES } from '~/site.config';

const metadata = {
  title: 'Formations en intelligence artificielle à Casablanca | Nova',
  ignoreTitleTemplate: true,
  description:
    "Apprenez à utiliser l'IA dans votre métier : programmes par niveau à Casablanca. Recevez le programme sur WhatsApp.",
  robots: { index: false, follow: false },
};

// Numéro WhatsApp Business propre à cette page (le reste du site n'est pas modifié).
const LANDING_WHATSAPP = '212708302114';
const wa = `https://wa.me/${LANDING_WHATSAPP}?text=${encodeURIComponent('Bonjour, je souhaite des informations sur vos formations.')}`;

const pixelId = ((import.meta.env.PUBLIC_META_PIXEL_ID as string | undefined) || '').replace(/[^0-9]/g, '');

const EXCLUDED = ['innovation'];
const all = (await getCollection('formations', ({ data }) => !data.draft && !EXCLUDED.includes(data.categorie))).sort(
  (a, b) => a.data.order - b.data.order
);
const groups = Object.entries(CATEGORIES)
  .filter(([key]) => !EXCLUDED.includes(key))
  .map(([key, c]) => ({ key, ...c, items: all.filter((f) => f.data.categorie === key) }))
  .filter((g) => g.items.length);

// Bandeau défilant : titres des programmes proposés (nettoyés des préfixes de niveau trop longs).
const ticker = [...all.map((f) => f.data.title), 'Formation sur mesure pour entreprises', 'Marketing digital'];

const facts = [
  { n: String(all.length), count: all.length, t: 'programmes de formation' },
  { n: '5', count: 5, suffix: ' ans', t: 'âge minimum avec IA Junior Academy' },
  { n: 'Casablanca', t: 'centre de formation au Maroc' },
];

const steps = [
  {
    t: 'Vous remplissez le formulaire',
    d: 'Votre nom, votre numéro et le programme qui vous intéresse.',
    icon: 'tabler:forms',
  },
  {
    t: "WhatsApp s'ouvre",
    d: 'Votre demande est déjà rédigée. Il suffit d’appuyer sur « Envoyer ».',
    icon: 'tabler:brand-whatsapp',
  },
  {
    t: 'Nous vous conseillons',
    d: 'Notre équipe vous répond avec le programme adapté à votre profil.',
    icon: 'tabler:message-check',
  },
];

const benefits = [
  {
    icon: 'tabler:stairs-up',
    t: 'Un niveau pour chacun',
    d: 'Des fondations de l’IA aux usages professionnels, vous entrez au niveau qui vous correspond.',
  },
  {
    icon: 'tabler:briefcase',
    t: 'L’IA appliquée à votre métier',
    d: 'Des programmes « IA + Métier » pour utiliser l’IA dans votre travail de tous les jours.',
  },
  {
    icon: 'tabler:brand-whatsapp',
    t: 'Une réponse humaine',
    d: 'Vous échangez directement avec notre équipe sur WhatsApp, sans formulaire interminable.',
  },
];

const faq = [
  {
    question: 'Quel programme choisir ?',
    answer:
      'Dans le formulaire, choisissez « Je ne sais pas encore, conseillez-moi ». Nous vous orienterons selon votre profil, votre niveau et votre objectif.',
  },
  {
    question: 'Faut-il savoir programmer pour suivre une formation ?',
    answer:
      "Non. Les programmes de niveau 1 sont conçus comme des fondations : vous n'avez pas besoin d'être informaticien pour commencer.",
  },
  {
    question: 'À qui s’adressent les formations ?',
    answer:
      'Aux enfants et adolescents avec IA Junior Academy, aux étudiants et aux professionnels. Les entreprises peuvent aussi demander une formation sur mesure.',
  },
  {
    question: 'Combien coûte une formation ?',
    answer: 'Cela dépend du programme. Nous vous donnons le tarif en dirhams (DH) dès votre demande.',
  },
  {
    question: 'Que se passe-t-il après l’envoi du formulaire ?',
    answer:
      'WhatsApp s’ouvre avec votre demande déjà rédigée. Une fois envoyée, notre équipe vous répond sur WhatsApp.',
  },
  {
    question: 'Mes données sont-elles protégées ?',
    answer:
      'Nous les utilisons uniquement pour répondre à votre demande, conformément à la loi marocaine n° 09-08. Vous pouvez lire notre politique de confidentialité en bas de page.',
  },
];
---

<Layout metadata={metadata}>
  <Fragment slot="head">
    {
      pixelId && (
        <>
          <script
            is:inline
            set:html={`!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src='https://connect.facebook.net/en_US/fbevents.js';s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script');fbq('init','${pixelId}');fbq('track','PageView');document.addEventListener('nova:lead',function(){fbq('track','Lead')});`}
          />
          <noscript>
            <img
              height="1"
              width="1"
              style="display:none"
              alt=""
              src={`https://www.facebook.com/tr?id=${pixelId}&ev=PageView&noscript=1`}
            />
          </noscript>
        </>
      )
    }
  </Fragment>

  <!-- En-tête réduit : logo au centre sur téléphone, à gauche dès la tablette ; WhatsApp à droite -->
  <header class="sticky top-0 z-40 border-b border-[#111111] bg-white/95 backdrop-blur">
    <div class="relative mx-auto flex h-16 max-w-7xl items-center justify-center px-4 sm:justify-between sm:px-6">
      <a href="/offre" class="inline-flex min-h-11 items-center" aria-label={`${SITE_CONFIG.name}, accueil de l'offre`}>
        <Logo height={36} fetchpriority="high" />
      </a>
      <div class="flex items-center gap-2 max-sm:absolute max-sm:right-4">
        <a href={wa} class="btn-whatsapp text-sm" target="_blank" rel="noopener noreferrer">
          <Icon name="tabler:brand-whatsapp" class="h-5 w-5" aria-hidden="true" />
          <span class="max-sm:sr-only">WhatsApp</span>
        </a>
        <a href="#inscription" class="btn-primary text-sm max-sm:hidden">Recevoir le programme</a>
      </div>
    </div>
  </header>

  <main id="contenu" class="flex-1">
    <!-- Hero : promesse à gauche, formulaire à droite (sous le titre sur téléphone) -->
    <section class="relative isolate overflow-hidden border-b border-[#111111] bg-white text-[#111111]">
      <div
        class="pointer-events-none absolute right-0 top-0 -z-10 h-full w-1/3 bg-[#e4f84a] max-lg:hidden"
        aria-hidden="true"
      >
      </div>
      <div
        class="mx-auto grid max-w-7xl items-start gap-8 px-4 py-8 sm:px-6 md:py-12 lg:grid-cols-12 lg:gap-12 lg:py-16"
      >
        <div class="lg:col-span-7">
          <p
            class="hero-in inline-block bg-[#e4f84a] px-2 py-1 text-xs font-semibold uppercase tracking-widest max-sm:hidden"
          >
            Centre de formation en intelligence artificielle
          </p>
          <h1
            class="hero-in mt-4 max-w-[680px] text-4xl font-semibold tracking-tight text-balance md:text-5xl lg:text-6xl"
            style="--d:80ms"
          >
            Apprenez à utiliser <span class="hl">l'IA</span> dans votre métier, à Casablanca
          </h1>
          <p class="hero-in mt-4 max-w-[680px] text-lg text-[#333333] max-sm:hidden" style="--d:160ms">
            Des programmes par niveau pour étudiants, professionnels et enfants dès 5 ans. Laissez votre numéro : nous
            vous conseillons le bon programme sur WhatsApp.
          </p>
          <p class="hero-in mt-3 text-base text-[#333333] sm:hidden" style="--d:160ms">
            Pour tous les profils, dès 5 ans. Laissez votre numéro : nous vous répondons sur WhatsApp.
          </p>
          <ul class="mt-6 grid gap-3 text-base font-medium max-lg:hidden" role="list">
            {
              [
                'Choisissez parmi tous nos programmes dans le formulaire',
                'Aucun engagement, la réponse arrive sur WhatsApp',
                'Un conseiller vous aide à choisir le bon niveau',
              ].map((t, i) => (
                <li class="hero-in flex items-center gap-3" style={`--d:${240 + i * 80}ms`}>
                  <span class="flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#111111] text-[#e4f84a]">
                    <Icon name="tabler:check" class="h-4 w-4" aria-hidden="true" />
                  </span>
                  {t}
                </li>
              ))
            }
          </ul>
        </div>

        <div id="inscription" class="hero-in scroll-mt-24 lg:col-span-5" style="--d:200ms">
          <div
            class="form-card relative rounded-xl border border-[#111111] bg-white p-4 shadow-[6px_6px_0_#111111] sm:p-6"
          >
            <p class="mb-3 inline-flex items-center gap-2 rounded-full bg-[#f1f1ec] px-3 py-1 text-xs font-semibold">
              <span class="live-dot" aria-hidden="true"></span>
              Réponse sur WhatsApp
            </p>
            <h2 class="text-2xl font-semibold text-[#111111]">Recevez le programme sur WhatsApp</h2>
            <p class="mb-4 mt-1 text-base text-[#4a4a46]">Quelques champs, moins d'une minute.</p>
            <LeadForm formId="form-offre" whatsapp={LANDING_WHATSAPP} />
          </div>
        </div>
      </div>
    </section>

    <!-- Bandeau défilant des programmes -->
    <section class="overflow-hidden border-b border-[#111111] bg-[#e4f84a] text-[#111111]" aria-label="Nos programmes">
      <div class="ticker flex w-max gap-0 py-3" aria-hidden="true">
        {
          [0, 1].map(() => (
            <ul class="flex shrink-0 items-center" role="presentation">
              {ticker.map((t) => (
                <li class="flex items-center whitespace-nowrap px-6 text-sm font-semibold">
                  {t}
                  <Icon name="tabler:point-filled" class="ml-6 h-3 w-3" aria-hidden="true" />
                </li>
              ))}
            </ul>
          ))
        }
      </div>
    </section>

    <!-- Faits vérifiables, avec compteurs animés -->
    <section class="bg-[#111111] text-white" aria-label="Nova en quelques chiffres">
      <ul class="mx-auto grid max-w-7xl gap-2 px-4 py-8 sm:grid-cols-3 sm:px-6" role="list">
        {
          facts.map((f) => (
            <li class="flex items-baseline gap-3 py-2 sm:flex-col sm:gap-1">
              <span class="text-4xl font-semibold text-[#e4f84a]">
                <span data-count={f.count}>{f.n}</span>
                {f.suffix}
              </span>
              <span class="text-sm text-[#e5e5df]">{f.t}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Programmes -->
    <section class="rv bg-white py-16 md:py-24" aria-labelledby="prog-title">
      <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <p class="inline-block bg-[#e4f84a] px-2 py-1 text-xs font-semibold uppercase tracking-widest">Programmes</p>
        <h2 id="prog-title" class="mt-3 max-w-[680px] text-3xl font-semibold tracking-tight text-balance md:text-5xl">
          Un programme pour chaque profil
        </h2>
        <p class="mt-3 max-w-[680px] text-base text-[#4a4a46]">
          Touchez un programme : il est présélectionné dans le formulaire.
        </p>
        <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {
            groups.map((g, i) => (
              <div class="card rv-item rounded-xl border border-[#111111] bg-white p-6" style={`--i:${i}`}>
                <div class="flex items-center gap-3">
                  <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-[#e4f84a]">
                    <Icon name={g.icon} class="h-6 w-6" aria-hidden="true" />
                  </span>
                  <h3 class="text-xl font-semibold">{g.label}</h3>
                </div>
                <p class="mt-3 text-sm text-[#4a4a46]">{g.description}</p>
                <ul class="mt-4" role="list">
                  {g.items.map((f) => (
                    <li>
                      <a
                        href="#inscription"
                        data-pick={f.id}
                        class="pick flex min-h-11 items-center justify-between gap-3 border-t border-[#e5e5df] py-2 text-sm font-medium"
                      >
                        <span>{f.data.title}</span>
                        <Icon name="tabler:arrow-right" class="h-4 w-4 shrink-0" aria-hidden="true" />
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
          <div
            class="card rv-item rounded-xl border border-[#111111] bg-[#111111] p-6 text-white"
            style={`--i:${groups.length}`}
          >
            <div class="flex items-center gap-3">
              <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-[#e4f84a] text-[#111111]">
                <Icon name="tabler:building" class="h-6 w-6" aria-hidden="true" />
              </span>
              <h3 class="text-xl font-semibold">Entreprises</h3>
            </div>
            <p class="mt-3 text-sm text-[#e5e5df]">
              Former vos équipes ou développer vos ventes avec le marketing digital.
            </p>
            <ul class="mt-4" role="list">
              {
                [
                  ['sur-mesure', 'Formation sur mesure pour mon entreprise'],
                  ['service-marketing', 'Service marketing digital'],
                ].map(([id, t]) => (
                  <li>
                    <a
                      href="#inscription"
                      data-pick={id}
                      class="pick pick-dark flex min-h-11 items-center justify-between gap-3 border-t border-white/20 py-2 text-sm font-medium"
                    >
                      <span>{t}</span>
                      <Icon name="tabler:arrow-right" class="h-4 w-4 shrink-0" aria-hidden="true" />
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Promesse : les mots s'allument un par un au défilement, cube 3D à côté -->
    <section class="overflow-hidden bg-[#111111] py-16 text-white md:py-24" aria-labelledby="promesse-title">
      <div class="mx-auto grid max-w-7xl items-center gap-8 px-4 sm:px-6 lg:grid-cols-12 lg:gap-12">
        <h2
          id="promesse-title"
          data-tagline
          class="text-3xl font-semibold tracking-tight text-balance md:text-4xl lg:col-span-7 lg:text-5xl"
        >
          Comprendre l'IA ne demande pas d'être informaticien. Avec le bon programme, au bon niveau, chacun peut
          l'utiliser dans son métier.
        </h2>
        <div class="lg:col-span-5">
          <LandingCube />
        </div>
      </div>
    </section>

    <!-- Comment ça marche -->
    <section class="rv bg-[#f1f1ec] py-16 md:py-24" aria-labelledby="steps-title">
      <div class="mx-auto max-w-7xl px-4 sm:px-6">
        <p class="inline-block bg-[#e4f84a] px-2 py-1 text-xs font-semibold uppercase tracking-widest">
          En trois étapes
        </p>
        <h2 id="steps-title" class="mt-3 max-w-[680px] text-3xl font-semibold tracking-tight text-balance md:text-5xl">
          Comment ça marche
        </h2>
        <ol class="mt-8 grid gap-4 md:grid-cols-3" role="list">
          {
            steps.map((s, i) => (
              <li class="card rv-item rounded-xl border border-[#111111] bg-white p-6" style={`--i:${i}`}>
                <div class="flex items-center justify-between">
                  <span class="flex h-12 w-12 items-center justify-center rounded-lg bg-[#e4f84a]">
                    <Icon name={s.icon} class="h-6 w-6" aria-hidden="true" />
                  </span>
                  <span class="text-4xl font-semibold text-[#d8d8d2]" aria-hidden="true">
                    {i + 1}
                  </span>
                </div>
                <h3 class="mt-4 text-xl font-semibold">{s.t}</h3>
                <p class="mt-2 text-base text-[#4a4a46]">{s.d}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <!-- Bénéfices -->
    <section class="rv bg-white py-16 md:py-24" aria-labelledby="why-title">
      <div class="mx-auto grid max-w-7xl gap-8 px-4 sm:px-6 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-5">
          <p class="inline-block bg-[#e4f84a] px-2 py-1 text-xs font-semibold uppercase tracking-widest">Nova</p>
          <h2 id="why-title" class="mt-3 text-3xl font-semibold tracking-tight text-balance md:text-5xl">
            Pourquoi choisir Nova
          </h2>
          <Photo
            name="atelier-formation"
            alt="Participants en atelier de formation autour d'un ordinateur portable"
            tint={false}
            aspect="4/3"
            widths={[400, 640, 800]}
            sizes="(min-width: 1024px) 480px, 92vw"
            class="mt-8 !rounded-xl border border-[#111111]"
          />
        </div>
        <ul class="grid gap-4 lg:col-span-7" role="list">
          {
            benefits.map((b, i) => (
              <li class="card rv-item flex gap-4 rounded-xl border border-[#111111] bg-white p-6" style={`--i:${i}`}>
                <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-[#e4f84a]">
                  <Icon name={b.icon} class="h-6 w-6" aria-hidden="true" />
                </span>
                <span>
                  <span class="block text-xl font-semibold">{b.t}</span>
                  <span class="mt-1 block text-base text-[#4a4a46]">{b.d}</span>
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- FAQ -->
    <section class="rv bg-[#f1f1ec] py-16 md:py-24" aria-labelledby="faq-title">
      <div class="mx-auto grid max-w-7xl gap-8 px-4 sm:px-6 lg:grid-cols-12 lg:gap-12">
        <h2 id="faq-title" class="text-3xl font-semibold tracking-tight md:text-5xl lg:col-span-4">Vos questions</h2>
        <div class="lg:col-span-8"><Faq items={faq} /></div>
      </div>
    </section>

    <!-- Appel final : même formulaire que le haut de page -->
    <section class="rv border-t border-[#111111] bg-[#e4f84a] py-16 md:py-24" aria-labelledby="final-title">
      <div class="mx-auto grid max-w-7xl items-start gap-8 px-4 sm:px-6 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-6">
          <h2 id="final-title" class="max-w-[680px] text-3xl font-semibold tracking-tight text-balance md:text-5xl">
            Prêt à choisir votre programme ?
          </h2>
          <p class="mt-4 max-w-[680px] text-lg text-[#222222]">
            Laissez votre numéro : nous vous répondons sur WhatsApp, sans engagement.
          </p>
        </div>
        <div class="lg:col-span-6">
          <div class="rounded-xl border border-[#111111] bg-white p-4 shadow-[6px_6px_0_#111111] sm:p-6">
            <LeadForm formId="form-offre-bas" whatsapp={LANDING_WHATSAPP} />
          </div>
        </div>
      </div>
    </section>
  </main>

  <footer class="bg-[#111111] text-white">
    <div
      class="mx-auto flex max-w-7xl flex-col gap-4 px-4 py-8 text-sm sm:px-6 md:flex-row md:items-center md:justify-between"
    >
      <p class="text-[#e5e5df]">
        © {new Date().getFullYear()}
        {SITE_CONFIG.name}, {SITE_CONFIG.contact.address.street}, {SITE_CONFIG.contact.address.city}
      </p>
      <nav aria-label="Informations légales" class="flex flex-wrap gap-x-6">
        <a class="inline-flex min-h-11 items-center underline underline-offset-2" href="/mentions-legales">
          Mentions légales
        </a>
        <a class="inline-flex min-h-11 items-center underline underline-offset-2" href="/politique-de-confidentialite">
          Politique de confidentialité
        </a>
      </nav>
    </div>
  </footer>
</Layout>

<style>
  /* « l'IA » surlignée en citron : le trait se dessine de gauche à droite (transform seulement) */
  .hl {
    position: relative;
    z-index: 0;
    white-space: nowrap;
  }
  .hl::before {
    content: '';
    position: absolute;
    inset: 0.12em -0.12em 0.02em;
    z-index: -1;
    background: #e4f84a;
    transform-origin: left center;
    transform: scaleX(0);
    animation: hl-draw 700ms cubic-bezier(0.22, 1, 0.36, 1) 600ms forwards;
  }
  @keyframes hl-draw {
    to {
      transform: scaleX(1);
    }
  }

  /* Pastille « en ligne » : l'anneau pulse (transform et opacité) */
  .live-dot {
    position: relative;
    display: inline-block;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: #16a34a;
  }
  .live-dot::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 9999px;
    background: #16a34a;
    animation: live-pulse 2s cubic-bezier(0.22, 1, 0.36, 1) infinite;
  }
  @keyframes live-pulse {
    from {
      transform: scale(1);
      opacity: 0.6;
    }
    to {
      transform: scale(3);
      opacity: 0;
    }
  }

  /* Bandeau défilant : deux copies, décalage de 50 %, pause au survol */
  .ticker {
    animation: ticker 45s linear infinite;
  }
  @media (hover: hover) and (pointer: fine) {
    .ticker:hover {
      animation-play-state: paused;
    }
  }
  @keyframes ticker {
    to {
      transform: translateX(-50%);
    }
  }

  /* Cartes : légère montée au survol */
  .card {
    transition:
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }
  @media (hover: hover) and (pointer: fine) {
    .card:hover {
      transform: translateY(-4px);
      box-shadow: 6px 6px 0 #111111;
    }
  }
  .pick {
    transition: background-color 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  @media (hover: hover) and (pointer: fine) {
    .pick:hover {
      background: #f7fcc4;
    }
    .pick-dark:hover {
      background: rgb(255 255 255 / 10%);
    }
  }

  /* Apparition des sections et des cartes : montée de 32 px et fondu, une seule fois */
  :global(.rv-on) .rv {
    opacity: 0;
    transform: translateY(32px);
    transition:
      opacity 700ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  :global(.rv-on) .rv.in {
    opacity: 1;
    transform: none;
  }
  :global(.rv-on) .rv .rv-item {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 600ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 600ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 0.5s cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: calc(var(--i, 0) * 60ms + 120ms);
  }
  :global(.rv-on) .rv.in .rv-item {
    opacity: 1;
    transform: none;
  }
  @media (hover: hover) and (pointer: fine) {
    :global(.rv-on) .rv.in .rv-item:hover {
      transform: translateY(-4px);
      box-shadow: 6px 6px 0 #111111;
      transition-delay: 0ms;
    }
  }

  /* Promesse : chaque mot passe du gris atténué au blanc */
  :global(.tw) {
    color: rgb(255 255 255 / 30%);
    transition: color 600ms cubic-bezier(0.22, 1, 0.36, 1);
  }
  :global(.tw.on) {
    color: #ffffff;
  }

  @media (prefers-reduced-motion: reduce) {
    .hl::before {
      animation: none;
      transform: none;
    }
    .live-dot::after,
    .ticker {
      animation: none;
    }
    .card {
      transition: none;
    }
  }
</style>

<script is:inline>
  // Active les apparitions seulement si le mouvement est permis ; sans JavaScript, tout reste visible.
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('rv-on');
  }
</script>

<script>
  // Un clic sur un programme le présélectionne dans les deux formulaires de la page.
  document.querySelectorAll<HTMLAnchorElement>('[data-pick]').forEach((a) => {
    a.addEventListener('click', () => {
      const id = a.dataset.pick;
      document.querySelectorAll<HTMLSelectElement>('select[name="formation"]').forEach((select) => {
        if (id && [...select.options].some((o) => o.value === id)) select.value = id;
      });
    });
  });

  const motion = !matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window;
  if (motion) {
    // Sections : apparition une seule fois
    const sectionObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('in');
            sectionObserver.unobserve(e.target);
          }
        });
      },
      { rootMargin: '0px 0px -10% 0px' }
    );
    document.querySelectorAll('.rv').forEach((el) => sectionObserver.observe(el));

    // Compteurs : de 0 à la valeur, une seule fois, quand le chiffre apparaît
    const countObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          countObserver.unobserve(e.target);
          const el = e.target as HTMLElement;
          const to = Number(el.dataset.count);
          const start = performance.now();
          const tick = (now: number) => {
            const t = Math.min(1, (now - start) / 1100);
            const eased = 1 - Math.pow(1 - t, 3);
            el.textContent = String(Math.round(to * eased));
            if (t < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        });
      },
      { threshold: 0.6 }
    );
    document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => countObserver.observe(el));

    // Promesse : mot par mot
    const tagline = document.querySelector<HTMLElement>('[data-tagline]');
    if (tagline) {
      const words = (tagline.textContent || '').trim().split(/\s+/);
      tagline.setAttribute('aria-label', words.join(' '));
      tagline.textContent = '';
      const spans = words.map((w, i) => {
        const s = document.createElement('span');
        s.className = 'tw';
        s.setAttribute('aria-hidden', 'true');
        s.textContent = w;
        tagline.append(s, i < words.length - 1 ? ' ' : '');
        return s;
      });
      const wordObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('on');
              wordObserver.unobserve(e.target);
            }
          });
        },
        { rootMargin: '0px 0px -35% 0px' }
      );
      spans.forEach((s) => wordObserver.observe(s));
    }
  }
</script>
