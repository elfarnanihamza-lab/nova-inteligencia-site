---
import { Icon } from 'astro-icon/components';
import Layout from '~/layouts/PageLayout.astro';
import PageHero from '~/components/nova/PageHero.astro';
import Section from '~/components/nova/Section.astro';
import ContactForm from '~/components/nova/ContactForm.astro';
import Photo from '~/components/nova/Photo.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import { SITE_CONFIG, whatsappLink } from '~/site.config';
import { ph } from '~/utils/placeholders';
import { SHOW_PLACEHOLDERS } from '~/site.config';
import { breadcrumbSchema } from '~/utils/schema';
import { formationHref } from '~/utils/formation-links';

const metadata = {
  title: 'Formation IA entreprise au Maroc : ChatGPT et automatisation',
  ignoreTitleTemplate: true,
  description:
    'Formation IA en entreprise à Casablanca et au Maroc : ChatGPT, prompts, agents IA et automatisation IA pour vos équipes. Demandez votre devis Nova.',
  openGraph: { images: [{ url: '~/assets/images/og/entreprises.png', width: 1200, height: 630 }] },
};

const themes = [
  { icon: 'tabler:message-chatbot', title: 'IA générative et prompts', text: "Prendre en main ChatGPT, Claude, Gemini, Perplexity et les outils d'IA générative, avec du prompt engineering avancé." },
  { icon: 'tabler:robot', title: 'Agents IA et assistants', text: 'Créer des assistants personnalisés avec bases de connaissances et instructions avancées.' },
  { icon: 'tabler:settings-automation', title: 'Automatisation et workflows', text: 'Automatiser les tâches répétitives, construire des workflows et connecter ses outils via les API.' },
  { icon: 'tabler:briefcase', title: 'IA appliquée à votre métier', text: "Cursus « IA + Métier » : des usages adaptés à votre fonction, de l'initiation au niveau professionnel." },
];

// Accompagnements au-delà des thématiques de formation : uniquement des programmes présents au catalogue.
const beyond = [
  {
    icon: 'tabler:cpu',
    title: 'Innovation et solutions technologiques',
    text: "Construire, intégrer, exploiter et commercialiser des solutions fondées sur l'IA et la donnée, avec un conseil en transformation digitale et en innovation.",
    href: formationHref('innovation-ia-solutions-technologiques'),
  },
  {
    icon: 'tabler:rocket',
    title: 'Accompagnement des startups',
    text: 'StartUp Booster : un programme gratuit pour incuber, accélérer et développer votre startup.',
    href: formationHref('startup-booster'),
  },
  {
    icon: 'tabler:device-laptop',
    title: 'Montée en compétences digitales',
    text: "Nova Digital Master Program : les principaux métiers du digital, les outils professionnels et l'intelligence artificielle.",
    href: formationHref('nova-digital-master-program'),
  },
];

const steps = [
  ['Échange', 'Nous écoutons votre contexte, vos équipes et vos objectifs.'],
  ['Conception', 'Nous construisons un programme sur mesure à partir de notre catalogue.'],
  ['Formation', 'Vos collaborateurs se forment avec des cas pratiques liés à votre activité.'],
  ['Suivi', "Nous faisons le point sur l'adoption et les prochaines étapes."],
];
---

<Layout metadata={metadata}>
  <StructuredData
    slot="head"
    schema={breadcrumbSchema([
      { name: 'Accueil', url: SITE_CONFIG.url },
      { name: 'Entreprises', url: `${SITE_CONFIG.url}/entreprises` },
    ])}
  />
  <PageHero
    tagline="Entreprises"
    title="Formez vos équipes à l'IA, sur mesure"
    subtitle="Nova conçoit des programmes de formation à l'intelligence artificielle adaptés à votre société, à vos métiers et à vos outils."
    crumbs={[{ text: 'Entreprises' }]}
  >
    <div class="mt-8 flex flex-col gap-4 sm:flex-row">
      <a href="#devis" class="btn-primary">Demander un devis</a>
      <a
        href={whatsappLink("Bonjour, je souhaite une formation IA sur mesure pour mon entreprise.")}
        class="btn"
        {...SITE_CONFIG.contact.whatsapp ? { target: '_blank', rel: 'noopener noreferrer' } : {}}>{SITE_CONFIG.contact.whatsapp ? 'Écrire sur WhatsApp' : 'Nous contacter'}</a
      >
    </div>
  </PageHero>

  <Section tagline="Thématiques" title="Des formations concrètes pour vos collaborateurs" align="left">
    <div class="grid gap-12 lg:grid-cols-12 lg:items-start lg:gap-16">
      <div class="relative lg:sticky lg:top-28 lg:col-span-5">
        <Photo
          name="equipe-marketing"
          alt="Une équipe suit une présentation sur écran dans une salle de réunion lumineuse"
          aspect="4/5"
          class="rounded-[1.75rem] shadow-[0_40px_80px_-48px_rgb(11_31_58/55%)]"
          sizes="(min-width: 1024px) 460px, 100vw"
          position="60% center"
        />
        <div class="absolute -bottom-5 left-5 right-5 rounded-2xl bg-white p-5 shadow-[0_24px_48px_-24px_rgb(11_31_58/45%)] sm:left-auto sm:right-6 sm:w-72">
          <p class="text-sm font-semibold text-heading">Un programme construit avec vous</p>
          <p class="mt-1 text-sm text-muted">À partir de notre catalogue, adapté à vos métiers et à vos outils.</p>
        </div>
      </div>
      <ul class="lg:col-span-7 border-t border-line" role="list">
        {
          themes.map((t, i) => (
            <li class="group border-b border-line py-7">
              <div class="flex gap-5">
                <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-offwhite text-ink ring-1 ring-line transition-colors duration-300 group-hover:bg-brand-gradient group-hover:text-white group-hover:ring-transparent">
                  <Icon name={t.icon} class="h-6 w-6" aria-hidden="true" />
                </span>
                <div class="transition-transform duration-500 group-hover:translate-x-1">
                  <h3 class="text-xl font-semibold tracking-tight text-heading">{t.title}</h3>
                  <p class="mt-2 leading-relaxed text-muted">{t.text}</p>
                </div>
              </div>
            </li>
          ))
        }
        <li class="pt-8">
          <a href="#devis" class="btn-primary">
            Demander un devis
            <Icon name="tabler:arrow-right" class="h-5 w-5" aria-hidden="true" />
          </a>
        </li>
      </ul>
    </div>
  </Section>

  <Section tone="soft" tagline="Au-delà de la formation" title="Innover et transformer votre organisation" subtitle="Des programmes complémentaires pour aller de la montée en compétences jusqu'aux projets technologiques.">
    <div class="grid gap-6 md:grid-cols-3">
      {
        beyond.map((b, i) => (
          <a href={b.href} class="group flex flex-col rounded-2xl border border-line bg-white p-7 transition-colors hover:border-[#111111]">
            <Icon name={b.icon} class="h-7 w-7 text-ink" aria-hidden="true" />
            <h3 class="mt-4 text-lg font-bold text-heading">{b.title}</h3>
            <p class="mt-2 flex-1 leading-relaxed text-muted">{b.text}</p>
            <span class="mt-5 inline-flex items-center gap-1.5 font-semibold text-ink">
              Voir le programme <Icon name="tabler:arrow-right" class="h-4 w-4 transition-transform group-hover:translate-x-1" aria-hidden="true" />
            </span>
          </a>
        ))
      }
    </div>
  </Section>

  {/* Démarche proposée par nos soins : affichée seulement en mode relecture tant que Nova ne l'a pas validée. */}
  {SHOW_PLACEHOLDERS && (
  <Section tone="soft" tagline="Notre démarche" title="Comment ça se passe ?" subtitle="[Proposition – à valider] Démarche à confirmer par Nova.">
    <ol class="grid gap-6 md:grid-cols-4">
      {
        steps.map(([t, d], i) => (
          <li class="rounded-2xl border border-line bg-white p-6">
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-primary font-bold text-white">{i + 1}</span>
            <h3 class="mt-3 text-lg font-bold text-heading">{t}</h3>
            <p class="mt-1 text-muted">{d}</p>
          </li>
        ))
      }
    </ol>
    {SHOW_PLACEHOLDERS && <p class="mt-8 text-center text-muted" set:html={ph('Formats (intra-entreprise, sur site, en ligne), tailles de groupe, langues et tarifs : [À COMPLÉTER]')} />}
  </Section>
  )}

  <Section id="devis" tagline="Devis" title="Parlons de votre projet de formation">
    <div class="mx-auto max-w-2xl rounded-2xl border border-line bg-white p-6 shadow-sm md:p-8">
      <ContactForm formId="form-entreprise" profil="entreprise" formation="sur-mesure" buttonLabel="Demander un devis" />
    </div>
  </Section>
</Layout>
