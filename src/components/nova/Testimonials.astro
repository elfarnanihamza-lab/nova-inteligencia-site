---
/**
 * Section « Ils nous font confiance » : avis clients en carrousel à défilement continu, direction « Nova AI » :
 * fond bleu nuit, lignes technologiques fines (grille estompée autour de l'en-tête), cartes en verre (transparence
 * par dégradés, sans backdrop-filter : coûteux sur des cartes animées et inutile sur un fond uniforme), bordure
 * lumineuse qui s'allume au survol, élévation légère. Recommandations ui-ux-pro-max : Glassmorphism (bordure 1px
 * translucide, profondeur), carrousel auto avec précédent/suivant + pause, arrêt au focus/survol/mouvement réduit.
 * - Données : src/data/testimonials.ts. Sans témoignage à afficher, la section n'est pas rendue du tout.
 * - Défilement : une seule boucle requestAnimationFrame qui déplace la piste par `transform` (de droite à gauche).
 *   Ordinateur et tablette : mouvement continu et lent. Mobile (< 640 px) : une carte centrée à la fois, qui glisse
 *   vers la suivante toutes les 5 s. Pour une boucle sans saut, la série est recopiée en JavaScript ; les copies sont
 *   `inert` et masquées aux lecteurs d'écran (chaque témoignage n'est lu qu'une fois).
 * - Pause : survol, focus clavier dans la zone, bouton pause (toujours visible, en bas du carrousel), hors écran,
 *   onglet masqué. Balayage tactile horizontal (le défilement vertical de la page reste libre).
 * - Flèches précédent/suivant : discrètes sur ordinateur (visibles au survol de la zone ou au focus clavier),
 *   toujours visibles au toucher (pas de survol sur mobile). Aucune numérotation ni barre de progression.
 * - prefers-reduced-motion : liste défilable classique (accroche aux cartes), aucun mouvement ; les flèches font
 *   défiler d'une carte et le bouton pause est masqué (rien à mettre en pause).
 * - Sans JavaScript : même liste défilable ; flèches et pause restent masquées (aucun bouton sans action).
 * - La pause « focus dans la zone » ne vaut que pour le focus clavier (:focus-visible) ; « Reprendre » l'emporte.
 */
import { Icon } from 'astro-icon/components';
import { visibleTestimonials } from '~/data/testimonials';

// Un avis sans citation ou sans nom n'est pas affiché (carte vide, signature vide).
const items = visibleTestimonials.filter((t) => t.quote?.trim() && t.name?.trim());

// Initiales : premier et dernier mot, premier graphème de chacun (les emoji et les écritures non latines ne sont jamais coupés
// en deux) ; mots sans lettre (emoji, ponctuation) ignorés ; sans initiale possible, une icône de personne.
const segmenter =
  typeof Intl !== 'undefined' && 'Segmenter' in Intl
    ? new Intl.Segmenter(undefined, { granularity: 'grapheme' })
    : null;
const firstGlyph = (w: string) =>
  segmenter ? ([...segmenter.segment(w)][0]?.segment ?? '') : (Array.from(w)[0] ?? '');
const initials = (name: string) => {
  const words = name
    .trim()
    .split(/\s+/)
    .filter((w) => /\p{L}/u.test(firstGlyph(w)));
  if (!words.length) return '';
  const first = firstGlyph(words[0]);
  const last = words.length > 1 ? firstGlyph(words[words.length - 1]) : '';
  return (first + last).toLocaleUpperCase();
};
const hasDemo = items.some((t) => t.demo);
---

{
  items.length > 0 && (
    <section class="tm cv-auto relative isolate overflow-hidden bg-navy text-white" aria-labelledby="tm-title">
      <div class="tm-bg pointer-events-none absolute inset-0" aria-hidden="true" />
      <div class="tm-lines pointer-events-none absolute inset-0" aria-hidden="true" />
      <span class="tm-scan pointer-events-none absolute inset-x-0 top-0" aria-hidden="true" />
      <div class="relative mx-auto max-w-7xl px-4 pt-16 sm:px-6 md:pt-24 lg:pt-28">
        <header class="mx-auto max-w-3xl text-center">
          <p class="inline-flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.22em] text-[#e4f84a]">
            <span class="tm-eyebrow-line" aria-hidden="true" />
            Ils nous font confiance
            <span class="tm-eyebrow-line is-right" aria-hidden="true" />
          </p>
          <h2
            id="tm-title"
            class="mt-4 font-heading text-[2.1rem] font-semibold leading-[1.06] tracking-[-0.035em] text-white text-balance md:text-[3.1rem]"
          >
            Des résultats concrets, <span class="text-gradient-light">racontés par nos clients</span>
          </h2>
          <p class="mx-auto mt-5 max-w-2xl text-lg leading-relaxed text-[#b9c6dc]">
            Découvrez comment l'intelligence artificielle peut transformer les méthodes de travail et les compétences
            professionnelles.
          </p>
          {hasDemo && (
            <p class="tm-demo-note mx-auto mt-5 inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-xs font-medium">
              <Icon name="tabler:info-circle" class="h-4 w-4 text-[#e4f84a]" aria-hidden="true" />
              Témoignages illustratifs — exemples fictifs
            </p>
          )}
        </header>
      </div>

      <div class="tm-stage relative mt-12 pb-16 md:mt-14 md:pb-24 lg:pb-28" data-tm>
        <div class="tm-viewport" data-tm-viewport>
          <ul class="tm-track" role="list" aria-label="Témoignages d'apprenants" data-tm-track>
            {items.map((t, i) => (
              <li class="tm-slide" style={`--i:${i}`}>
                <figure class="tm-card">
                  <span class="tm-card-glow" aria-hidden="true" />
                  <div class="tm-top">
                    <span class="tm-quote" aria-hidden="true">
                      <Icon name="tabler:quote-filled" />
                    </span>
                    {t.rating && (
                      <p class="tm-stars" role="img" aria-label={`Note : ${t.rating} sur 5`}>
                        {[1, 2, 3, 4, 5].map((n) => (
                          <Icon
                            name="tabler:star-filled"
                            class:list={['h-4 w-4', n > t.rating! && 'is-off']}
                            aria-hidden="true"
                          />
                        ))}
                      </p>
                    )}
                  </div>
                  <blockquote class="tm-text" dir="auto">
                    « {t.quote} »
                  </blockquote>
                  <figcaption class="tm-author">
                    {t.photo ? (
                      <img
                        src={t.photo}
                        alt=""
                        width="48"
                        height="48"
                        loading="lazy"
                        decoding="async"
                        class="tm-photo h-12 w-12 shrink-0 rounded-full object-cover"
                      />
                    ) : (
                      <span class="tm-avatar" aria-hidden="true">
                        {initials(t.name) || <Icon name="tabler:user" class="h-5 w-5" />}
                      </span>
                    )}
                    <span class="min-w-0">
                      <span class="block font-semibold text-white [overflow-wrap:anywhere]" dir="auto">
                        {t.name}
                      </span>
                      {(t.role || t.company) && (
                        <span class="block text-sm text-[#a8a8a0] [overflow-wrap:anywhere]" dir="auto">
                          {t.role}
                          {t.role && t.company && ' · '}
                          {t.company}
                        </span>
                      )}
                      {t.formation && (
                        <span
                          class="mt-0.5 block text-xs font-medium leading-snug text-[#e4f84a] [overflow-wrap:anywhere]"
                          dir="auto"
                        >
                          {t.formation}
                        </span>
                      )}
                    </span>
                  </figcaption>
                </figure>
              </li>
            ))}
          </ul>
        </div>
        <button type="button" class="tm-nav tm-prev" data-tm-prev aria-label="Témoignage précédent" hidden>
          <Icon name="tabler:chevron-left" aria-hidden="true" />
        </button>
        <button type="button" class="tm-nav tm-next" data-tm-next aria-label="Témoignage suivant" hidden>
          <Icon name="tabler:chevron-right" aria-hidden="true" />
        </button>
        <button
          type="button"
          class="tm-pause"
          data-tm-toggle
          hidden
          aria-pressed="false"
          aria-label="Mettre en pause le défilement des témoignages"
        >
          <Icon name="tabler:player-pause-filled" class="tm-ico-pause" aria-hidden="true" />
          <Icon name="tabler:player-play-filled" class="tm-ico-play" aria-hidden="true" />
        </button>
      </div>
    </section>
  )
}

<style>
  /* Fond : bleu nuit, halo bleu électrique sous l'en-tête, rappel cyan en bas à droite */
  .tm-bg {
    background:
      radial-gradient(55% 60% at 50% 0%, rgb(17 17 17 / 32%), transparent 70%),
      radial-gradient(40% 50% at 100% 100%, rgb(228 248 74 / 12%), transparent 70%),
      linear-gradient(180deg, #051440 0%, #111111 55%, #000000 100%);
  }
  /* Lignes technologiques fines : grille 64 px, estompée par un masque radial (visible seulement autour du titre) */
  .tm-lines {
    background-image:
      linear-gradient(rgb(228 248 74 / 7%) 1px, transparent 1px),
      linear-gradient(90deg, rgb(228 248 74 / 7%) 1px, transparent 1px);
    background-size: 64px 64px;
    background-position: center top;
    -webkit-mask-image: radial-gradient(ellipse 60% 55% at 50% 22%, #000 15%, transparent 72%);
    mask-image: radial-gradient(ellipse 60% 55% at 50% 22%, #000 15%, transparent 72%);
  }
  /* Ligne d'horizon lumineuse : transition nette avec la section précédente */
  .tm-scan {
    height: 1px;
    background: linear-gradient(90deg, transparent, rgb(228 248 74 / 70%) 50%, transparent);
  }
  .tm-eyebrow-line {
    display: block;
    width: 2rem;
    height: 1px;
    background: linear-gradient(90deg, transparent, #b8cc1a);
  }
  .tm-eyebrow-line.is-right {
    background: linear-gradient(90deg, #b8cc1a, transparent);
  }
  .tm-demo-note {
    border: 1px solid rgb(228 248 74 / 22%);
    background: rgb(255 255 255 / 5%);
    color: #c7d3e6;
  }

  /* Liste défilable par défaut (sans JavaScript ou avec mouvement réduit) */
  .tm-viewport {
    overscroll-behavior-x: contain;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding: 0.75rem 0 1.75rem;
  }
  .tm-viewport::-webkit-scrollbar {
    display: none;
  }
  .tm-track {
    --gap: 1.5rem;
    --card: min(82vw, 21rem);
    display: flex;
    gap: var(--gap);
    width: max-content;
    padding-inline: max(1rem, calc((100vw - 80rem) / 2 + 1.5rem));
  }
  .tm-slide {
    display: flex;
    width: var(--card);
    flex-shrink: 0;
    scroll-snap-align: center;
  }
  @media (min-width: 1024px) {
    .tm-track {
      --card: 22rem;
      --gap: 1.5rem;
    }
  }
  /* Défilement continu (JavaScript actif, mouvement autorisé) */
  .tm-stage.is-auto .tm-viewport {
    overflow: hidden;
    scroll-snap-type: none;
    touch-action: pan-y; /* le balayage horizontal est géré par le script, le défilement vertical reste natif */
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }
  .tm-stage.is-auto .tm-track {
    padding-inline: 0;
    will-change: transform;
  }
  .tm-stage.is-dragging .tm-viewport {
    cursor: grabbing;
  }

  /* Carte en verre : transparence maîtrisée par dégradés, bord translucide, reflet en haut, profondeur */
  .tm-card {
    position: relative;
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 17.5rem;
    padding: 1.75rem 1.75rem 1.5rem;
    border: 1px solid rgb(228 248 74 / 14%);
    border-radius: 1.5rem;
    background: linear-gradient(160deg, rgb(255 255 255 / 7%), rgb(255 255 255 / 2.5%) 45%, rgb(228 248 74 / 5%));
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 8%),
      0 24px 50px -30px rgb(0 0 0 / 75%);
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }
  /* Repère technologique : court trait cyan sur le bord supérieur */
  .tm-card::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 1.75rem;
    width: 2.75rem;
    height: 2px;
    border-radius: 2px;
    background: linear-gradient(90deg, #b8cc1a, transparent);
  }
  /* Bordure lumineuse : invisible au repos, s'allume au survol (masque = seulement le liseré) */
  .tm-card-glow {
    position: absolute;
    inset: -1px;
    padding: 1px;
    border-radius: inherit;
    background: linear-gradient(
      140deg,
      rgb(228 248 74 / 80%),
      rgb(228 248 74 / 0%) 38%,
      rgb(17 17 17 / 0%) 62%,
      rgb(228 248 74 / 55%)
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box exclude,
      linear-gradient(#000 0 0);
    opacity: 0;
    transition: opacity 0.2s ease;
    pointer-events: none;
  }
  @media (hover: hover) and (pointer: fine) {
    .tm-card:hover {
      border-color: rgb(228 248 74 / 26%);
      box-shadow:
        inset 0 1px 0 rgb(255 255 255 / 10%),
        0 34px 64px -32px rgb(228 248 74 / 42%);
    }
    .tm-card:hover .tm-card-glow {
      opacity: 1;
    }
  }
  /* Apparition en cascade des cartes à l'entrée de la section (propriété `translate`, pour ne pas bloquer le
     `transform` du survol) */
  :global(.js) .tm-stage.is-revealed .tm-card {
    animation: tm-in 0.28s cubic-bezier(0.23, 1, 0.32, 1) both;
    animation-delay: calc(var(--i, 0) * 40ms + 80ms);
  }
  @keyframes tm-in {
    from {
      opacity: 0;
      translate: 0 14px;
    }
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  .tm-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }
  .tm-quote {
    display: grid;
    width: 2.6rem;
    height: 2.6rem;
    place-items: center;
    border: 1px solid rgb(228 248 74 / 22%);
    border-radius: 0.85rem;
    background: rgb(228 248 74 / 10%);
    color: #e4f84a;
  }
  .tm-quote :global(svg) {
    width: 1.3rem;
    height: 1.3rem;
  }
  .tm-stars {
    display: flex;
    gap: 0.15rem;
    margin-top: 0.35rem;
    color: #ffb36b;
  }
  .tm-stars :global(.is-off) {
    color: rgb(255 255 255 / 18%);
  }
  .tm-text {
    /* hauteur bornée : un avis très long ne rend pas toutes les cartes géantes (8 lignes au plus) ; URL et mots longs se coupent */
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 8;
    line-clamp: 8;
    overflow-wrap: anywhere;
    flex: 1;
    margin-top: 1.1rem;
    color: #e3ebf8;
    font-size: 1.02rem;
    line-height: 1.65;
  }
  .tm-author {
    display: flex;
    min-height: 5.6rem;
    align-items: flex-start;
    gap: 0.9rem;
    margin-top: 1.5rem;
    padding-top: 1.15rem;
    border-top: 1px solid rgb(228 248 74 / 12%);
  }
  .tm-avatar {
    display: grid;
    flex-shrink: 0;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 9999px;
    background: linear-gradient(135deg, #111111, #b8cc1a);
    box-shadow:
      0 0 0 3px rgb(228 248 74 / 16%),
      0 8px 18px -8px rgb(228 248 74 / 60%);
    color: #fff;
    font-size: 0.9rem;
    font-weight: 700;
  }
  .tm-photo {
    box-shadow: 0 0 0 3px rgb(228 248 74 / 16%);
  }

  /* Flèches précédent/suivant : verre sombre, discrètes sur ordinateur (survol de la zone ou focus clavier) */
  .tm-nav {
    position: absolute;
    top: 50%;
    z-index: 3;
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    flex-shrink: 0;
    place-items: center;
    border: 1px solid rgb(228 248 74 / 30%);
    border-radius: 9999px;
    background: rgb(17 17 17 / 78%);
    color: #e6f4ff;
    box-shadow: 0 12px 26px -14px rgb(0 0 0 / 80%);
    opacity: 0;
    pointer-events: none;
    transform: translateY(-50%);
    transition:
      opacity 0.25s ease,
      transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      background-color 0.25s ease,
      border-color 0.25s ease;
  }
  .tm-nav :global(svg) {
    width: 1.3rem;
    height: 1.3rem;
  }
  .tm-prev {
    left: 0.5rem;
  }
  .tm-next {
    right: 0.5rem;
  }
  @media (min-width: 640px) {
    .tm-prev {
      left: 1rem;
    }
    .tm-next {
      right: 1rem;
    }
  }
  @media (hover: hover) and (pointer: fine) {
    .tm-stage:hover .tm-nav,
    .tm-stage:focus-within .tm-nav {
      opacity: 1;
      pointer-events: auto;
    }
    .tm-nav:hover {
      transform: translateY(-50%) scale(1.07);
      border-color: #e4f84a;
      background: rgb(228 248 74 / 24%);
    }
  }
  /* Toucher : pas de survol, donc toujours visibles et cliquables */
  @media (pointer: coarse) {
    .tm-nav {
      width: 2.5rem;
      height: 2.5rem;
      opacity: 1;
      pointer-events: auto;
    }
  }
  .tm-nav:focus-visible {
    opacity: 1;
    pointer-events: auto;
    outline: 3px solid rgb(228 248 74 / 70%);
    outline-offset: 2px;
  }
  .tm-nav:active {
    transform: translateY(-50%) scale(0.93);
  }
  .tm-nav[hidden] {
    display: none;
  }

  /* Pause/reprise : commande toujours visible (pas de survol requis), sous le carrousel */
  .tm-pause {
    position: absolute;
    bottom: 0.25rem;
    left: 50%;
    z-index: 3;
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    flex-shrink: 0;
    place-items: center;
    border: 1px solid rgb(228 248 74 / 30%);
    border-radius: 9999px;
    background: rgb(255 255 255 / 6%);
    color: #e6f4ff;
    transform: translateX(-50%);
    transition:
      transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
      background-color 0.25s ease,
      border-color 0.25s ease;
  }
  .tm-pause :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }
  .tm-pause :global(.tm-ico-play) {
    display: none;
  }
  .is-user-paused .tm-pause :global(.tm-ico-pause) {
    display: none;
  }
  .is-user-paused .tm-pause :global(.tm-ico-play) {
    display: block;
  }
  @media (hover: hover) and (pointer: fine) {
    .tm-pause:hover {
      border-color: #e4f84a;
      background: rgb(228 248 74 / 20%);
    }
  }
  .tm-pause:active {
    transform: translateX(-50%) scale(0.92);
  }
  .tm-pause:focus-visible {
    outline: 3px solid rgb(228 248 74 / 70%);
    outline-offset: 2px;
  }
  .tm-pause[hidden] {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .tm-card,
    .tm-card-glow,
    .tm-nav,
    .tm-pause {
      transition: none;
    }
    :global(.js) .tm-stage.is-revealed .tm-card {
      animation: none;
    }
    .tm-card:hover {
      transform: none;
    }
  }
</style>

<script>
  const SPEED = 26; // px/s : lent, pour laisser le temps de lire (mode continu)
  const HOLD = 5000; // ms d'affichage d'une carte avant la suivante (mode carte par carte, mobile)
  const cleanups: Array<() => void> = [];
  const ease = (p: number) => 1 - Math.pow(1 - p, 3);

  const setup = (stage: HTMLElement) => {
    const viewport = stage.querySelector<HTMLElement>('[data-tm-viewport]')!;
    const track = stage.querySelector<HTMLElement>('[data-tm-track]')!;
    const originals = [...track.children] as HTMLElement[];
    // Un seul avis : rien à faire défiler (une boucle répéterait la même carte) ; les commandes restent masquées.
    if (originals.length < 2) return;
    const prev = stage.querySelector<HTMLButtonElement>('[data-tm-prev]')!;
    const next = stage.querySelector<HTMLButtonElement>('[data-tm-next]')!;
    const toggle = stage.querySelector<HTMLButtonElement>('[data-tm-toggle]')!;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Mouvement réduit : liste défilable (balayage, molette, clavier), aucun mouvement automatique.
    // Les flèches font alors défiler d'une carte ; rien n'est automatique, donc pas de bouton pause.
    // Les commandes sont rendues masquées (aucun bouton sans action sans JavaScript) : on les révèle ici.
    prev.hidden = false;
    next.hidden = false;
    if (reduce) {
      const by = (dir: number) =>
        viewport.scrollBy({ left: dir * (originals[0].getBoundingClientRect().width + 24), behavior: 'auto' });
      prev.addEventListener('click', () => by(-1));
      next.addEventListener('click', () => by(1));
      return;
    }

    stage.classList.add('is-auto');
    toggle.hidden = false;

    // Copies pour une boucle continue : inertes et masquées aux technologies d'assistance.
    let setW = 0,
      step = 0,
      center = 0;
    const clones: HTMLElement[] = [];
    let mode: 'flow' | 'step' = 'flow';
    const measure = () => {
      const gap = parseFloat(getComputedStyle(track).columnGap) || 0;
      const cardW = originals[0].getBoundingClientRect().width; // fractionnaire : offsetWidth arrondit et décalerait le raccord
      step = cardW + gap;
      setW = step * originals.length;
      // mobile : une carte principale centrée, avec un aperçu des voisines
      mode = viewport.clientWidth < 640 ? 'step' : 'flow';
      center = mode === 'step' ? (viewport.getBoundingClientRect().width - cardW) / 2 : 0;
      const need = Math.ceil((viewport.clientWidth + setW) / setW); // séries nécessaires pour toujours couvrir l'écran
      const have = 1 + clones.length / originals.length;
      for (let k = have; k < need; k++) {
        for (const o of originals) {
          const c = o.cloneNode(true) as HTMLElement;
          c.setAttribute('aria-hidden', 'true');
          c.setAttribute('inert', '');
          c.dataset.clone = '';
          track.appendChild(c);
          clones.push(c);
        }
      }
    };

    let x = 0; // décalage courant (px), ramené dans [0, setW[
    let hold = 0; // temps passé sur la carte courante (mode carte par carte)
    let raf = 0,
      last = 0,
      running = false;
    let userPaused = false,
      visible = false,
      focused = false;
    let nudge: { from: number; to: number; t0: number } | null = null;
    let drag: { id: number; x0: number; y0: number; start: number; active: boolean } | null = null;
    let resumeAt = 0;
    const canHover = window.matchMedia('(hover: hover)').matches;
    const hovered = () => canHover && stage.matches(':hover');
    const moving = () => !userPaused && !focused && !hovered() && !drag && performance.now() >= resumeAt;

    const render = () => {
      const v = (((x - center) % setW) + setW) % setW; // la boucle reste continue : les copies prennent le relais
      track.style.transform = `translate3d(${-v}px, 0, 0)`;
    };
    const frame = (now: number) => {
      raf = requestAnimationFrame(frame);
      const dt = Math.min(0.05, (now - last) / 1000);
      last = now;
      if (nudge) {
        const p = Math.min(1, (now - nudge.t0) / 420);
        x = nudge.from + (nudge.to - nudge.from) * ease(p);
        if (p >= 1) nudge = null;
      } else if (moving()) {
        if (mode === 'flow') x += SPEED * dt;
        else if ((hold += dt * 1000) >= HOLD) {
          hold = 0;
          nudge = { from: x, to: (Math.floor(x / step + 0.001) + 1) * step, t0: now };
        }
      }
      render();
    };
    const start = () => {
      if (running || !visible || document.hidden) return;
      running = true;
      last = performance.now();
      raf = requestAnimationFrame(frame);
    };
    const stop = () => {
      running = false;
      cancelAnimationFrame(raf);
    };

    // Flèches : glissement jusqu'à la carte précédente/suivante, dans les deux modes (continu et carte par carte)
    const go = (dir: 1 | -1) => {
      const base = nudge ? nudge.to : x;
      const target =
        dir === 1 ? (Math.floor(base / step + 0.001) + 1) * step : (Math.ceil(base / step - 0.001) - 1) * step;
      nudge = { from: x, to: target, t0: performance.now() };
      hold = 0;
      resumeAt = performance.now() + 2500;
      start();
    };
    prev.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));
    toggle.addEventListener('click', () => {
      userPaused = !userPaused;
      stage.classList.toggle('is-user-paused', userPaused);
      toggle.setAttribute('aria-pressed', String(userPaused));
      toggle.setAttribute(
        'aria-label',
        userPaused ? 'Reprendre le défilement des témoignages' : 'Mettre en pause le défilement des témoignages'
      );
      // « Reprendre » est une demande explicite : elle l'emporte sur la pause liée au focus clavier
      if (!userPaused) focused = false;
    });

    // le focus clavier n'est jamais déplacé ; le défilement s'arrête tant qu'il se trouve dans la zone.
    // Seul le focus clavier compte (:focus-visible) : après un clic souris, le bouton garde le focus sans figer la piste.
    stage.addEventListener('focusin', (e) => {
      if ((e.target as HTMLElement).matches(':focus-visible')) focused = true;
    });
    stage.addEventListener('focusout', (e) => {
      if (!stage.contains(e.relatedTarget as Node)) focused = false;
    });

    // Balayage (doigt ou souris) : horizontal seulement, le défilement vertical de la page reste libre
    viewport.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      drag = { id: e.pointerId, x0: e.clientX, y0: e.clientY, start: x, active: false };
      nudge = null;
    });
    viewport.addEventListener('pointermove', (e) => {
      if (!drag || e.pointerId !== drag.id) return;
      const dx = e.clientX - drag.x0,
        dy = e.clientY - drag.y0;
      if (!drag.active) {
        if (Math.abs(dy) > Math.abs(dx) && Math.abs(dy) > 6) {
          drag = null; // geste vertical : on laisse la page défiler
          return;
        }
        if (Math.abs(dx) < 6) return;
        drag.active = true;
        stage.classList.add('is-dragging');
        viewport.setPointerCapture(e.pointerId);
      }
      x = drag.start - dx;
      render();
    });
    const endDrag = (e: PointerEvent) => {
      if (!drag || e.pointerId !== drag.id) return;
      if (drag.active) {
        // accroche douce sur la carte la plus proche
        nudge = { from: x, to: Math.round(x / step) * step, t0: performance.now() };
        hold = 0;
        resumeAt = performance.now() + 3000;
      }
      drag = null;
      stage.classList.remove('is-dragging');
    };
    viewport.addEventListener('pointerup', endDrag);
    viewport.addEventListener('pointercancel', endDrag);
    // un glissement souris ne doit pas déclencher de clic ni de sélection de texte
    viewport.addEventListener('dragstart', (e) => e.preventDefault());

    const ro = new ResizeObserver(() => {
      measure();
      render();
    });
    ro.observe(viewport);
    const io = new IntersectionObserver(
      ([e]) => {
        visible = e.isIntersecting;
        if (visible) start();
        else stop();
      },
      { threshold: 0.2 }
    );
    io.observe(viewport);
    const onVis = () => (document.hidden ? stop() : start());
    document.addEventListener('visibilitychange', onVis);

    cleanups.push(() => {
      stop();
      ro.disconnect();
      io.disconnect();
      document.removeEventListener('visibilitychange', onVis);
    });
  };

  // Initialisation seulement à l'approche de la section (aucun coût au chargement de la page)
  const init = () => {
    document.querySelectorAll<HTMLElement>('[data-tm]:not([data-ready])').forEach((stage) => {
      stage.dataset.ready = '1';
      const near = new IntersectionObserver(
        ([e]) => {
          if (!e.isIntersecting) return;
          near.disconnect();
          setup(stage);
        },
        { rootMargin: '600px 0px' }
      );
      near.observe(stage);
      cleanups.push(() => near.disconnect());
    });
  };
  document.addEventListener('astro:page-load', init);
  document.addEventListener('astro:before-swap', () => {
    while (cleanups.length) cleanups.pop()!();
  });
</script>
