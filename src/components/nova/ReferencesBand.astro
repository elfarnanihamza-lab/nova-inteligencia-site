---
/**
 * Bandeau « Nos références » affiché en bas de toutes les pages, juste avant le pied de page.
 * Logos fournis par Nova (versions claires, faites pour fond sombre) : src/assets/brand/refs/.
 * Liste et libellés : REFERENCES dans src/site.config.ts. `enabled: false` masque le bandeau.
 * Ces logos ne sont PAS repris dans les données structurées (JSON-LD) : aucune affiliation n'y est déclarée.
 */
import { Image } from 'astro:assets';
import amiia from '~/assets/brand/refs/amiia.png';
import ministere from '~/assets/brand/refs/ministere-transition-numerique.png';
import aaai from '~/assets/brand/refs/aaai.png';
import aaia from '~/assets/brand/refs/aaia.png';
import novaNm from '~/assets/brand/refs/nova-new-mexico.png';
import { REFERENCES } from '~/site.config';

const logos = { amiia, ministere, aaai, aaia, novaNm } as const;
---

{
  REFERENCES.enabled && (
    <section class="refs border-t border-[#111111] bg-[#111111] text-white" aria-labelledby="refs-title">
      <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 md:py-16">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="inline-block bg-[#e4f84a] px-2 py-1 text-xs font-bold uppercase tracking-[0.14em] text-[#111111]">Références</p>
            <h2 id="refs-title" class="mt-4 font-heading text-3xl font-bold leading-tight tracking-[-0.03em] md:text-5xl">{REFERENCES.title}</h2>
          </div>
        </div>
        <ul class="mt-10 grid grid-cols-2 overflow-hidden rounded-md border-l border-t border-white/20 md:grid-cols-3 lg:grid-cols-5" role="list">
          {
            REFERENCES.items.map((r) => {
              const src = logos[r.logo as keyof typeof logos];
              return (
                <li class="ref-cell flex min-h-40 flex-col items-center justify-center gap-4 border-b border-r border-white/20 p-6 text-center max-md:last:col-span-2">
                  <Image src={src} alt={r.name} height={80} width={Math.round(80 * (src.width / src.height))} loading="lazy" class="ref-logo h-20 w-auto max-w-full object-contain" />
                  <span class="text-xs leading-snug text-[#e5e5df]">{r.name}</span>
                </li>
              );
            })
          }
        </ul>
      </div>
    </section>
  )
}

<style>
  .ref-logo {
    opacity: 0.92;
    transition: opacity 0.25s ease, transform 0.25s cubic-bezier(0.23, 1, 0.32, 1);
  }
  @media (hover: hover) and (pointer: fine) {
    .ref-cell:hover .ref-logo {
      opacity: 1;
      transform: scale(1.05);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ref-logo {
      transition: none;
    }
  }
</style>
