# Copiez ce fichier en .env (local, jamais versionné) ou renseignez ces variables chez votre hébergeur (Vercel, Netlify…).
#
# ⚠ Les variables PUBLIC_* sont intégrées au code envoyé aux visiteurs au moment du build (Astro) :
#   n'y mettez JAMAIS de secret (clé d'API, jeton, mot de passe). Une URL de webhook est visible par tout visiteur :
#   utilisez un webhook qui n'accepte que des POST et ne donne aucun accès en lecture.

# Numéro WhatsApp au format international, sans + ni espaces (ex. 2126XXXXXXXX). Vide : bouton WhatsApp masqué.
PUBLIC_WHATSAPP_NUMBER=

# URL du webhook qui reçoit les formulaires en JSON (Make, Zapier, n8n, Formspree, CRM…).
# Vide : le formulaire ouvre la messagerie du visiteur ; en mode démo, l'envoi est désactivé (message explicite).
PUBLIC_FORM_WEBHOOK=

# true : MODE DÉMONSTRATION — pages en « noindex, nofollow », pas de sitemap, robots.txt sans Disallow,
# formulaires désactivés sans webhook. (Les témoignages d'exemple ne s'affichent qu'en développement local.)
# Ce n'est PAS une protection d'accès. Jamais en production.
PUBLIC_DEMO_MODE=false

# true : affiche les contenus provisoires « [À COMPLÉTER] » surlignés (relecture).
PUBLIC_SHOW_PLACEHOLDERS=false

# Optionnel : variante du pied de page ('nuit' par défaut ou 'indigo').
# PUBLIC_FOOTER_VARIANT=nuit

# Optionnel (variable de build, non publique) : URL publique du site, utilisée pour les liens canoniques, les images de
# partage et le sitemap. Par défaut : `site` de src/config.yaml ; en mode démo sur Vercel, l'URL du projet
# (VERCEL_PROJECT_PRODUCTION_URL) est utilisée automatiquement si SITE_URL est absent.
# SITE_URL=https://votre-demo.vercel.app

# ─── Profil « démo Vercel » (à saisir dans Project → Settings → Environment Variables, pas dans le dépôt) ───
# PUBLIC_DEMO_MODE=true
# PUBLIC_SHOW_PLACEHOLDERS=false
# PUBLIC_WHATSAPP_NUMBER=212667944611
# PUBLIC_FORM_WEBHOOK=
